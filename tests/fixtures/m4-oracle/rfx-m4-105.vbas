Function OracleProbe() As Variant
On Error Resume Next
Err.Clear
Dim v As Variant
v = CaseValue()
If Err.Number <> 0 Then
Dim failure As Long
failure = Err.Number
On Error GoTo 0
Err.Raise failure
End If
OracleProbe = v
End Function

Function CaseValue() As Variant
CaseValue = InStr(Null, "x")
End Function
